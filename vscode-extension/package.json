{
  "name": "venc",
  "displayName": "venc — Vault ENCrypt",
  "description": "Edit encrypted vaults through an in-memory virtual filesystem.",
  "version": "0.1.0",
  "publisher": "ayano-yuki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:venc"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "venc.createVault",
        "title": "venc: Create Vault"
      },
      {
        "command": "venc.openVault",
        "title": "venc: Open Vault"
      },
      {
        "command": "venc.lockVault",
        "title": "venc: Lock Vault"
      }
    ],
    "configuration": {
      "title": "venc",
      "properties": {
        "venc.corePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the trusted venc executable on the extension host. Otherwise use the bundled bin/venc executable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node test/provider.test.cjs",
    "test:integration": "npm run compile && node test/run-vscode.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "test:backups": "npm run compile && node test/run-backup-probe.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
