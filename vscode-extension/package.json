{
  "name": "venc",
  "displayName": "venc \u2014 Vault ENCrypt",
  "description": "Edit two-password encrypted vaults with a protected editor, encrypted crash drafts, and a virtual filesystem.",
  "version": "0.3.0",
  "publisher": "ayano-yuki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:venc"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "venc.createVault",
        "title": "venc: Create Vault"
      },
      {
        "command": "venc.openVault",
        "title": "venc: Open Vault"
      },
      {
        "command": "venc.lockVault",
        "title": "venc: Lock Vault"
      },
      {
        "command": "venc.openAnotherVault",
        "title": "venc: Open Another Vault"
      },
      {
        "command": "venc.lockAllVaults",
        "title": "venc: Lock All Vaults",
        "enablement": "venc.hasUnlockedVault"
      },
      {
        "command": "venc.changePasswords",
        "title": "venc: Change Vault Passwords",
        "enablement": "venc.hasUnlockedVault"
      },
      {
        "command": "venc.forgetVault",
        "title": "venc: Forget Vault Location"
      },
      {
        "command": "venc.openProtectedFile",
        "title": "venc: Open in Protected Editor"
      }
    ],
    "configuration": {
      "title": "venc",
      "properties": {
        "venc.corePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the trusted venc executable on the extension host. Otherwise use the bundled bin/venc executable."
        },
        "venc.allowPlaintextAccess": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Enable compatibility access to decrypted files through the standard FileSystemProvider. **Unsafe for plaintext persistence:** standard editor backups, other extensions, language servers, and Save As can expose contents. Vaults disconnect when this setting changes. Use the protected editor by default."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "venc.protectedEditor",
        "displayName": "venc Protected Editor",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "venc.protectedFiles",
          "name": "venc: Protected Files"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "venc.openProtectedFile",
          "when": "resourceScheme == venc && !explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node test/provider.test.cjs",
    "test:integration": "npm run compile && node test/run-vscode.cjs",
    "package": "node scripts/package.cjs",
    "test:backups": "npm run compile && node test/run-backup-probe.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
