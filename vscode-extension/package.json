{
  "name": "venc",
  "displayName": "venc — Vault ENCrypt",
  "description": "Edit two-password encrypted vaults with a protected editor, encrypted crash drafts, and a virtual filesystem.",
  "version": "0.4.0",
  "publisher": "ayano-yuki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:venc"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "venc.createVault",
        "title": "venc: Create Vault",
        "icon": "$(new-folder)"
      },
      {
        "command": "venc.openVault",
        "title": "venc: Open Vault"
      },
      {
        "command": "venc.lockVault",
        "title": "venc: Lock Vault"
      },
      {
        "command": "venc.openAnotherVault",
        "title": "venc: Open Another Vault",
        "icon": "$(folder-opened)"
      },
      {
        "command": "venc.lockAllVaults",
        "title": "venc: Lock All Vaults",
        "enablement": "venc.hasUnlockedVault",
        "icon": "$(lock)"
      },
      {
        "command": "venc.changePasswords",
        "title": "venc: Change Vault Passwords",
        "enablement": "venc.hasUnlockedVault"
      },
      {
        "command": "venc.forgetVault",
        "title": "venc: Forget Vault Location"
      },
      {
        "command": "venc.openProtectedFile",
        "title": "venc: Open in Protected Editor"
      },
      {
        "command": "venc.unlockVault",
        "title": "venc: Unlock Selected Vault",
        "icon": "$(unlock)"
      },
      {
        "command": "venc.lockSelectedVault",
        "title": "venc: Lock Selected Vault",
        "icon": "$(lock)"
      },
      {
        "command": "venc.refreshVaults",
        "title": "venc: Refresh Vaults",
        "icon": "$(refresh)"
      },
      {
        "command": "venc.recoverDrafts",
        "title": "venc: Recover Encrypted Drafts",
        "icon": "$(history)",
        "enablement": "venc.hasUnlockedVault"
      },
      {
        "command": "venc.newFile",
        "title": "venc: New Encrypted File",
        "icon": "$(new-file)"
      },
      {
        "command": "venc.newFolder",
        "title": "venc: New Encrypted Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "venc.renameEntry",
        "title": "venc: Rename Vault Entry",
        "icon": "$(edit)"
      },
      {
        "command": "venc.deleteEntry",
        "title": "venc: Delete Vault Entry",
        "icon": "$(trash)"
      },
      {
        "command": "venc.openVaultFile",
        "title": "venc: Open Vault File"
      },
      {
        "command": "venc.selectEditorMode",
        "title": "venc: Choose Editor Mode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "venc.importFiles",
        "title": "venc: Import Files",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "venc.showStorage",
        "title": "venc: Vault Storage and Cleanup",
        "icon": "$(database)",
        "enablement": "venc.hasUnlockedVault"
      },
      {
        "command": "venc.retryFolder",
        "title": "venc: Retry Folder",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "venc",
      "properties": {
        "venc.corePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the trusted venc executable on the extension host. Otherwise use the bundled bin/venc executable."
        },
        "venc.allowPlaintextAccess": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Enable compatibility access to decrypted files through the standard FileSystemProvider. **Unsafe for plaintext persistence:** standard editor backups, other extensions, language servers, and Save As can expose contents. Vaults disconnect when this setting changes. Use the protected editor by default."
        },
        "venc.idleTimeoutMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 1440,
          "scope": "machine",
          "description": "Auto-lock each vault after this many minutes without activity (0 disables). Protected edits are encrypted as recoverable drafts before locking. Unsaved compatibility editors pause automatic locking to avoid discarding data."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "venc.protectedEditor",
        "displayName": "venc Protected Editor",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "venc": [
        {
          "id": "venc.protectedFiles",
          "name": "Protected Files",
          "contextualTitle": "venc"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "venc.openProtectedFile",
          "when": "resourceScheme == venc && !explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "venc.createVault",
          "when": "view == venc.protectedFiles",
          "group": "navigation@1"
        },
        {
          "command": "venc.openAnotherVault",
          "when": "view == venc.protectedFiles",
          "group": "navigation@2"
        },
        {
          "command": "venc.lockAllVaults",
          "when": "view == venc.protectedFiles && venc.hasUnlockedVault",
          "group": "navigation@3"
        },
        {
          "command": "venc.refreshVaults",
          "when": "view == venc.protectedFiles",
          "group": "navigation@4"
        },
        {
          "command": "venc.recoverDrafts",
          "when": "view == venc.protectedFiles && venc.hasUnlockedVault",
          "group": "navigation@5"
        },
        {
          "command": "venc.newFile",
          "when": "view == venc.protectedFiles && venc.hasUnlockedVault",
          "group": "navigation@6"
        },
        {
          "command": "venc.newFolder",
          "when": "view == venc.protectedFiles && venc.hasUnlockedVault",
          "group": "navigation@7"
        },
        {
          "command": "venc.selectEditorMode",
          "when": "view == venc.protectedFiles",
          "group": "mode"
        },
        {
          "command": "venc.importFiles",
          "when": "view == venc.protectedFiles && venc.hasUnlockedVault",
          "group": "navigation@8"
        },
        {
          "command": "venc.showStorage",
          "when": "view == venc.protectedFiles && venc.hasUnlockedVault",
          "group": "maintenance"
        }
      ],
      "view/item/context": [
        {
          "command": "venc.unlockVault",
          "when": "view == venc.protectedFiles && viewItem == vencLockedVault",
          "group": "inline"
        },
        {
          "command": "venc.lockSelectedVault",
          "when": "view == venc.protectedFiles && viewItem == vencUnlockedVault",
          "group": "inline"
        },
        {
          "command": "venc.newFile",
          "when": "view == venc.protectedFiles && (viewItem == vencDirectory || viewItem == vencUnlockedVault)",
          "group": "create"
        },
        {
          "command": "venc.newFolder",
          "when": "view == venc.protectedFiles && (viewItem == vencDirectory || viewItem == vencUnlockedVault)",
          "group": "create"
        },
        {
          "command": "venc.renameEntry",
          "when": "view == venc.protectedFiles && (viewItem == vencDirectory || viewItem == vencFile)",
          "group": "modify"
        },
        {
          "command": "venc.deleteEntry",
          "when": "view == venc.protectedFiles && (viewItem == vencDirectory || viewItem == vencFile)",
          "group": "modify"
        },
        {
          "command": "venc.importFiles",
          "when": "view == venc.protectedFiles && (viewItem == vencDirectory || viewItem == vencUnlockedVault)",
          "group": "create"
        }
      ],
      "commandPalette": [
        {
          "command": "venc.unlockVault",
          "when": "false"
        },
        {
          "command": "venc.lockSelectedVault",
          "when": "false"
        },
        {
          "command": "venc.renameEntry",
          "when": "false"
        },
        {
          "command": "venc.deleteEntry",
          "when": "false"
        },
        {
          "command": "venc.retryFolder",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "venc",
          "title": "venc",
          "icon": "media/vault.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "venc.protectedFiles",
        "contents": "Create a vault or open an existing one to edit encrypted files.\n[Create Vault](command:venc.createVault)\n[Open Vault](command:venc.openAnotherVault)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node test/provider.test.cjs && node test/idle.test.cjs",
    "test:integration": "npm run compile && node test/run-vscode.cjs",
    "package": "node scripts/package.cjs",
    "test:backups": "npm run compile && node test/run-backup-probe.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.7.0",
    "ws": "^8.22.0"
  }
}
